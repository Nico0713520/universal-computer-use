{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-computer-use.invalid/schemas/host-development-evidence-v1.json",
  "title": "Redacted Computer Use Named-Host Development Loop Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "status",
    "host",
    "system",
    "tools",
    "image_delivery",
    "continuous_loop",
    "automatic_mode",
    "task_results",
    "natural_stop",
    "timestamp",
    "reviewer"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "computer-use-host-development-loop" },
    "status": {
      "enum": ["development-passed", "failed", "blocked", "not-run"]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "reported_model_id"],
      "properties": {
        "name": { "enum": ["codex", "kimi", "hanaagent", "workbuddy"] },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][^\\u0000-\\u001f\\u007f]*$"
        },
        "reported_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\s\\u0000-\\u001f\\u007f](?:[^\\u0000-\\u001f\\u007f]*[^\\s\\u0000-\\u001f\\u007f])?$"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "os_version", "engine_version"],
      "properties": {
        "platform": { "const": "macos" },
        "os_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "maxLength": 32
        },
        "engine_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "computer_observe" },
        { "const": "computer_act" }
      ],
      "items": false
    },
    "image_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime_type",
        "first_turn_png",
        "later_turn_png",
        "same_host_reported_model"
      ],
      "properties": {
        "mime_type": { "const": "image/png" },
        "first_turn_png": { "type": "boolean" },
        "later_turn_png": { "type": "boolean" },
        "same_host_reported_model": { "type": "boolean" }
      }
    },
    "continuous_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeated_tool_calls", "turns_observed"],
      "properties": {
        "repeated_tool_calls": { "type": "boolean" },
        "turns_observed": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "automatic_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_confirmation_count", "host_authorization"],
      "properties": {
        "plugin_confirmation_count": { "const": 0 },
        "host_authorization": {
          "enum": [
            "no-host-prompt-observed",
            "host-approval-observed",
            "host-policy-blocked"
          ]
        }
      }
    },
    "task_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculator", "text_edit"],
      "properties": {
        "calculator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "expression", "visible_result", "exact_window_mode"],
          "properties": {
            "result": { "enum": ["passed", "failed", "not-run"] },
            "expression": { "const": "37x19" },
            "visible_result": { "enum": ["703", "not-observed"] },
            "exact_window_mode": { "type": "boolean" }
          }
        },
        "text_edit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "visible_gui_interaction", "one_use_sentence_recorded"],
          "properties": {
            "result": { "enum": ["passed", "failed", "not-run"] },
            "visible_gui_interaction": { "type": "boolean" },
            "one_use_sentence_recorded": { "const": false }
          }
        }
      }
    },
    "natural_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "tool_calls_after_visible_goal"],
      "properties": {
        "result": { "enum": ["passed", "failed", "not-run"] },
        "tool_calls_after_visible_goal": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]*$"
        },
        "method": { "const": "manual-host-development-runbook" }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "status",
        "image_delivery",
        "continuous_loop",
        "automatic_mode",
        "task_results",
        "natural_stop"
      ],
      "properties": {
        "status": { "const": "development-passed" },
        "image_delivery": {
          "type": "object",
          "required": ["first_turn_png", "later_turn_png", "same_host_reported_model"],
          "properties": {
            "first_turn_png": { "const": true },
            "later_turn_png": { "const": true },
            "same_host_reported_model": { "const": true }
          }
        },
        "continuous_loop": {
          "type": "object",
          "required": ["repeated_tool_calls", "turns_observed"],
          "properties": {
            "repeated_tool_calls": { "const": true },
            "turns_observed": { "type": "integer", "minimum": 2 }
          }
        },
        "automatic_mode": {
          "type": "object",
          "required": ["plugin_confirmation_count", "host_authorization"],
          "properties": {
            "plugin_confirmation_count": { "const": 0 },
            "host_authorization": {
              "enum": ["no-host-prompt-observed", "host-approval-observed"]
            }
          }
        },
        "task_results": {
          "type": "object",
          "required": ["calculator", "text_edit"],
          "properties": {
            "calculator": {
              "type": "object",
              "required": ["result", "visible_result", "exact_window_mode"],
              "properties": {
                "result": { "const": "passed" },
                "visible_result": { "const": "703" },
                "exact_window_mode": { "const": true }
              }
            },
            "text_edit": {
              "type": "object",
              "required": ["result", "visible_gui_interaction", "one_use_sentence_recorded"],
              "properties": {
                "result": { "const": "passed" },
                "visible_gui_interaction": { "const": true },
                "one_use_sentence_recorded": { "const": false }
              }
            }
          }
        },
        "natural_stop": {
          "type": "object",
          "required": ["result", "tool_calls_after_visible_goal"],
          "properties": {
            "result": { "const": "passed" },
            "tool_calls_after_visible_goal": { "const": 0 }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["failed", "blocked", "not-run"] }
      }
    }
  ]
}
