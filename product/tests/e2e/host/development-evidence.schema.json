{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-computer-use.invalid/schemas/host-development-evidence-v2.json",
  "title": "Redacted Computer Use Mac Agent Preview Host Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_origin",
    "evidence_type",
    "status",
    "build",
    "host",
    "system",
    "transport",
    "mcp",
    "image_delivery",
    "continuous_loop",
    "automatic_mode",
    "task_results",
    "natural_stop",
    "limitations",
    "non_pass_signal",
    "timestamp",
    "reviewer"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "evidence_origin": { "enum": ["external-run", "synthetic-example"] },
    "evidence_type": { "const": "computer-use-host-development-loop" },
    "status": {
      "enum": ["verified-development", "failed", "blocked", "not-run"]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "git_commit", "product", "protocol", "engine"],
      "properties": {
        "repository": {
          "const": "https://github.com/Nico0713520/universal-computer-use"
        },
        "git_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "product": { "const": "0.2.6" },
        "protocol": { "const": "1.2.0" },
        "engine": { "const": "0.22.2" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "reported_model_id"],
      "properties": {
        "name": { "enum": ["codex", "hanaagent", "workbuddy"] },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?!(?:[Ff][Ii][Ll][Ee]|[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp][Ss]?|[Mm][Aa][Ii][Ll][Tt][Oo]|[Dd][Aa][Tt][Aa]):)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:/Users/|/home/))(?!.+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$)[A-Za-z0-9](?:[A-Za-z0-9 ._:+/()@-]*[A-Za-z0-9)])?$"
        },
        "reported_model_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(?![A-Za-z]:[\\\\/])(?!(?:[Ff][Ii][Ll][Ee]|[Hh][Tt][Tt][Pp][Ss]?|[Ff][Tt][Pp][Ss]?|[Mm][Aa][Ii][Ll][Tt][Oo]|[Dd][Aa][Tt][Aa]):)(?![A-Za-z][A-Za-z0-9+.-]*://)(?!.*(?:/Users/|/home/))(?!.+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$)[A-Za-z0-9](?:[A-Za-z0-9 ._:+/()@-]*[A-Za-z0-9)])?$"
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "os_version", "arch"],
      "properties": {
        "platform": { "const": "macos" },
        "os_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "maxLength": 32
        },
        "arch": { "enum": ["arm64", "x64"] }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direct_stdio", "shell_bridge", "builtin_computer_use"],
      "properties": {
        "direct_stdio": { "type": "boolean" },
        "shell_bridge": { "type": "boolean" },
        "builtin_computer_use": { "type": "boolean" }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_name", "tools"],
      "properties": {
        "server_name": { "const": "computer-use" },
        "tools": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "prefixItems": [
            { "const": "computer_observe" },
            { "const": "computer_act" }
          ],
          "items": false
        }
      }
    },
    "image_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mime_type",
        "first_turn_png",
        "second_turn_png",
        "same_host_reported_model",
        "same_direct_loop"
      ],
      "properties": {
        "mime_type": { "const": "image/png" },
        "first_turn_png": { "type": "boolean" },
        "second_turn_png": { "type": "boolean" },
        "same_host_reported_model": { "type": "boolean" },
        "same_direct_loop": { "type": "boolean" }
      }
    },
    "continuous_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeated_tool_calls", "turns_observed"],
      "properties": {
        "repeated_tool_calls": { "type": "boolean" },
        "turns_observed": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "automatic_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plugin_confirmation_count", "host_authorization"],
      "properties": {
        "plugin_confirmation_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "host_authorization": {
          "enum": [
            "no-host-prompt-observed",
            "host-approval-observed",
            "host-policy-blocked"
          ]
        }
      }
    },
    "task_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calculator", "unique_input", "covered_window"],
      "properties": {
        "calculator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "visible_expression", "visible_result", "naturally_stopped"],
          "properties": {
            "result": { "enum": ["pass", "fail", "not-run"] },
            "visible_expression": { "enum": ["37×19", "not-observed"] },
            "visible_result": { "enum": ["703", "not-observed"] },
            "naturally_stopped": { "type": "boolean" }
          },
          "oneOf": [
            {
              "type": "object",
              "required": ["result", "visible_expression", "visible_result", "naturally_stopped"],
              "properties": {
                "result": { "const": "pass" },
                "visible_expression": { "const": "37×19" },
                "visible_result": { "const": "703" },
                "naturally_stopped": { "const": true }
              }
            },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": { "enum": ["fail", "not-run"] }
              }
            }
          ]
        },
        "unique_input": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "exact_value_confirmed",
            "write_count",
            "nonce_recorded",
            "naturally_stopped"
          ],
          "properties": {
            "result": { "enum": ["pass", "fail", "not-run"] },
            "exact_value_confirmed": { "type": "boolean" },
            "write_count": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "nonce_recorded": { "const": false },
            "naturally_stopped": { "type": "boolean" }
          },
          "oneOf": [
            {
              "type": "object",
              "required": [
                "result",
                "exact_value_confirmed",
                "write_count",
                "nonce_recorded",
                "naturally_stopped"
              ],
              "properties": {
                "result": { "const": "pass" },
                "exact_value_confirmed": { "const": true },
                "write_count": { "const": 1 },
                "nonce_recorded": { "const": false },
                "naturally_stopped": { "const": true }
              }
            },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": { "enum": ["fail", "not-run"] }
              }
            }
          ]
        },
        "covered_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "semantic_background_effect",
            "pixel_window_effect",
            "target_remained_background",
            "foreground_fallback",
            "naturally_stopped"
          ],
          "properties": {
            "result": { "enum": ["pass", "fail", "not-run"] },
            "semantic_background_effect": { "type": "boolean" },
            "pixel_window_effect": { "type": "boolean" },
            "target_remained_background": { "type": "boolean" },
            "foreground_fallback": { "enum": ["not-needed", "reported"] },
            "naturally_stopped": { "type": "boolean" }
          },
          "oneOf": [
            {
              "type": "object",
              "required": [
                "result",
                "semantic_background_effect",
                "pixel_window_effect",
                "target_remained_background",
                "foreground_fallback",
                "naturally_stopped"
              ],
              "properties": {
                "result": { "const": "pass" },
                "semantic_background_effect": { "const": true },
                "pixel_window_effect": { "const": true },
                "target_remained_background": { "const": true },
                "foreground_fallback": { "const": "not-needed" },
                "naturally_stopped": { "const": true }
              }
            },
            {
              "type": "object",
              "required": ["result"],
              "properties": {
                "result": { "enum": ["fail", "not-run"] }
              }
            }
          ]
        }
      }
    },
    "natural_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "tool_calls_after_goal"],
      "properties": {
        "result": { "enum": ["pass", "fail", "not-run"] },
        "tool_calls_after_goal": { "type": "integer", "minimum": 0, "maximum": 1000 }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "host-approval-observed",
          "foreground-fallback-reported",
          "host-image-delivery-incomplete",
          "host-loop-incomplete",
          "host-automatic-mode-limited",
          "task-incomplete",
          "host-policy-blocked",
          "precondition-blocked",
          "invalid-transport-observed",
          "task-failed",
          "task-not-run",
          "natural-stop-failed"
        ]
      }
    },
    "non_pass_signal": {
      "enum": [
        "none",
        "precondition-blocked",
        "invalid-transport-observed",
        "image-delivery-incomplete",
        "loop-incomplete",
        "host-policy-blocked",
        "task-failed",
        "task-not-run",
        "natural-stop-failed"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "maxLength": 40
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9]+(?:[._+-][A-Za-z0-9]+)*$"
        },
        "method": {
          "enum": ["manual-host-development-runbook", "synthetic-schema-example"]
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "status",
        "evidence_origin",
        "transport",
        "image_delivery",
        "continuous_loop",
        "automatic_mode",
        "task_results",
        "natural_stop",
        "limitations",
        "non_pass_signal",
        "reviewer"
      ],
      "properties": {
        "evidence_origin": { "const": "external-run" },
        "status": { "const": "verified-development" },
        "build": {
          "type": "object",
          "required": ["git_commit"],
          "properties": {
            "git_commit": {
              "type": "string",
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          }
        },
        "host": {
          "type": "object",
          "required": ["version", "reported_model_id"],
          "properties": {
            "version": { "type": "string", "pattern": "^(?!0\\.0\\.0-example$).+" },
            "reported_model_id": {
              "type": "string",
              "pattern": "^(?!example/model-token$).+"
            }
          }
        },
        "system": {
          "type": "object",
          "required": ["os_version"],
          "properties": {
            "os_version": { "type": "string", "pattern": "^(?!0\\.0\\.0$).+" }
          }
        },
        "transport": {
          "type": "object",
          "required": ["direct_stdio", "shell_bridge", "builtin_computer_use"],
          "properties": {
            "direct_stdio": { "const": true },
            "shell_bridge": { "const": false },
            "builtin_computer_use": { "const": false }
          }
        },
        "image_delivery": {
          "type": "object",
          "required": [
            "first_turn_png",
            "second_turn_png",
            "same_host_reported_model",
            "same_direct_loop"
          ],
          "properties": {
            "first_turn_png": { "const": true },
            "second_turn_png": { "const": true },
            "same_host_reported_model": { "const": true },
            "same_direct_loop": { "const": true }
          }
        },
        "continuous_loop": {
          "type": "object",
          "required": ["repeated_tool_calls", "turns_observed"],
          "properties": {
            "repeated_tool_calls": { "const": true },
            "turns_observed": { "type": "integer", "minimum": 2 }
          }
        },
        "automatic_mode": {
          "type": "object",
          "required": ["plugin_confirmation_count", "host_authorization"],
          "properties": {
            "plugin_confirmation_count": { "const": 0 },
            "host_authorization": {
              "enum": ["no-host-prompt-observed", "host-approval-observed"]
            }
          }
        },
        "task_results": {
          "type": "object",
          "required": ["calculator", "unique_input", "covered_window"],
          "properties": {
            "calculator": {
              "type": "object",
              "required": ["result", "visible_expression", "visible_result", "naturally_stopped"],
              "properties": {
                "result": { "const": "pass" },
                "visible_expression": { "const": "37×19" },
                "visible_result": { "const": "703" },
                "naturally_stopped": { "const": true }
              }
            },
            "unique_input": {
              "type": "object",
              "required": [
                "result",
                "exact_value_confirmed",
                "write_count",
                "nonce_recorded",
                "naturally_stopped"
              ],
              "properties": {
                "result": { "const": "pass" },
                "exact_value_confirmed": { "const": true },
                "write_count": { "const": 1 },
                "nonce_recorded": { "const": false },
                "naturally_stopped": { "const": true }
              }
            },
            "covered_window": {
              "type": "object",
              "required": [
                "result",
                "semantic_background_effect",
                "pixel_window_effect",
                "target_remained_background",
                "foreground_fallback",
                "naturally_stopped"
              ],
              "properties": {
                "result": { "const": "pass" },
                "semantic_background_effect": { "const": true },
                "pixel_window_effect": { "const": true },
                "target_remained_background": { "const": true },
                "foreground_fallback": { "const": "not-needed" },
                "naturally_stopped": { "const": true }
              }
            }
          }
        },
        "natural_stop": {
          "type": "object",
          "required": ["result", "tool_calls_after_goal"],
          "properties": {
            "result": { "const": "pass" },
            "tool_calls_after_goal": { "const": 0 }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "const": "host-approval-observed"
          }
        },
        "non_pass_signal": { "const": "none" },
        "reviewer": {
          "type": "object",
          "required": ["id", "method"],
          "properties": {
            "id": { "type": "string", "pattern": "^(?!synthetic-example$).+" },
            "method": { "const": "manual-host-development-runbook" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "status",
        "evidence_origin",
        "build",
        "host",
        "system",
        "limitations",
        "non_pass_signal",
        "reviewer"
      ],
      "properties": {
        "evidence_origin": { "const": "external-run" },
        "status": { "enum": ["failed", "blocked", "not-run"] },
        "build": {
          "type": "object",
          "required": ["git_commit"],
          "properties": {
            "git_commit": {
              "type": "string",
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
            }
          }
        },
        "host": {
          "type": "object",
          "required": ["version", "reported_model_id"],
          "properties": {
            "version": { "type": "string", "pattern": "^(?!0\\.0\\.0-example$).+" },
            "reported_model_id": {
              "type": "string",
              "pattern": "^(?!example/model-token$).+"
            }
          }
        },
        "system": {
          "type": "object",
          "required": ["os_version"],
          "properties": {
            "os_version": { "type": "string", "pattern": "^(?!0\\.0\\.0$).+" }
          }
        },
        "limitations": { "type": "array", "minItems": 1 },
        "non_pass_signal": {
          "enum": [
            "precondition-blocked",
            "invalid-transport-observed",
            "image-delivery-incomplete",
            "loop-incomplete",
            "host-policy-blocked",
            "task-failed",
            "task-not-run",
            "natural-stop-failed"
          ]
        },
        "reviewer": {
          "type": "object",
          "required": ["id", "method"],
          "properties": {
            "id": { "type": "string", "pattern": "^(?!synthetic-example$).+" },
            "method": { "const": "manual-host-development-runbook" }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "evidence_origin",
        "status",
        "build",
        "natural_stop",
        "non_pass_signal",
        "reviewer"
      ],
      "properties": {
        "evidence_origin": { "const": "synthetic-example" },
        "status": { "const": "not-run" },
        "build": {
          "type": "object",
          "required": ["git_commit"],
          "properties": {
            "git_commit": { "const": "0000000000000000000000000000000000000000" }
          }
        },
        "natural_stop": {
          "type": "object",
          "required": ["result", "tool_calls_after_goal"],
          "properties": {
            "result": { "const": "not-run" },
            "tool_calls_after_goal": { "const": 0 }
          }
        },
        "non_pass_signal": { "const": "task-not-run" },
        "reviewer": {
          "type": "object",
          "required": ["id", "method"],
          "properties": {
            "id": { "const": "synthetic-example" },
            "method": { "const": "synthetic-schema-example" }
          }
        }
      }
    }
  ]
}
