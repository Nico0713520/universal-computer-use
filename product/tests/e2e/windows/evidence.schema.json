{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-computer-use.invalid/schemas/windows-e2e-evidence-v1.json",
  "title": "Windows Computer Use E2E Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "stage",
    "promotable",
    "run_id",
    "generated_at",
    "engine",
    "host",
    "calibration",
    "signer",
    "runtime_report",
    "results",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "computer-use-windows-e2e" },
    "stage": { "enum": ["development", "candidate"] },
    "promotable": { "type": "boolean" },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "engine": { "$ref": "#/$defs/engine" },
    "host": { "$ref": "#/$defs/host" },
    "calibration": { "$ref": "#/$defs/calibration" },
    "signer": { "$ref": "#/$defs/signer" },
    "runtime_report": { "$ref": "#/$defs/runtimeReport" },
    "results": { "$ref": "#/$defs/results" },
    "limitations": { "$ref": "#/$defs/limitations" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "stage": { "const": "development" } }, "required": ["stage"] },
      "then": { "type": "object", "properties": { "promotable": { "const": false } } }
    },
    {
      "if": { "type": "object", "properties": { "stage": { "const": "candidate" } }, "required": ["stage"] },
      "then": {
        "type": "object",
        "properties": {
          "promotable": { "const": true },
          "engine": {
            "allOf": [
              { "$ref": "#/$defs/engine" },
              {
                "type": "object",
                "properties": {
                  "required_fix_commits": { "type": "array", "minItems": 1 }
                }
              }
            ]
          },
          "signer": {
            "allOf": [
              { "$ref": "#/$defs/signer" },
              {
                "type": "object",
                "properties": {
                  "status": { "const": "Valid" },
                  "subject": { "type": "string", "minLength": 1 },
                  "thumbprint": { "$ref": "#/$defs/thumbprint" }
                }
              }
            ]
          },
          "results": {
            "allOf": [
              { "$ref": "#/$defs/results" },
              {
                "type": "object",
                "properties": {
                  "iterations_expected": { "type": "integer", "minimum": 20 },
                  "iterations_passed": { "type": "integer", "minimum": 20 }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "thumbprint": { "type": "string", "pattern": "^[0-9A-F]{40}$" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "tag",
        "source_commit",
        "asset",
        "asset_sha256",
        "runtime_executable_sha256",
        "required_fix_commits",
        "required_tools",
        "contract_fingerprint_sha256"
      ],
      "properties": {
        "name": { "const": "cua-driver" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "tag": { "type": "string", "pattern": "^cua-driver-rs-v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "asset": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 160 },
        "asset_sha256": { "$ref": "#/$defs/sha256" },
        "runtime_executable_sha256": { "$ref": "#/$defs/sha256" },
        "required_fix_commits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/commit" }
        },
        "required_tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" }
        },
        "contract_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "executable_sha256"],
      "properties": {
        "name": { "enum": ["chrome", "edge"] },
        "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,4}$" },
        "executable_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os_name",
        "os_build",
        "architecture",
        "session_id",
        "session_state",
        "desktop_state",
        "dpi_percent",
        "browser"
      ],
      "properties": {
        "os_name": { "const": "Windows" },
        "os_build": { "type": "string", "pattern": "^[0-9]{5,6}$" },
        "architecture": { "const": "x64" },
        "session_id": { "type": "integer", "minimum": 1 },
        "session_state": { "const": "active" },
        "desktop_state": { "const": "unlocked" },
        "dpi_percent": { "enum": [100, 125, 150] },
        "browser": { "$ref": "#/$defs/browser" }
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "measured_at",
        "content_origin_x_px",
        "content_origin_y_px",
        "screenshot_width_px",
        "screenshot_height_px",
        "source_screenshot_sha256",
        "zoom_percent"
      ],
      "properties": {
        "method": { "const": "visible-origin-marker-screenshot-pixel-measurement" },
        "measured_at": { "type": "string", "format": "date-time" },
        "content_origin_x_px": { "type": "integer", "minimum": 0 },
        "content_origin_y_px": { "type": "integer", "minimum": 0 },
        "screenshot_width_px": { "type": "integer", "minimum": 1280 },
        "screenshot_height_px": { "type": "integer", "minimum": 800 },
        "source_screenshot_sha256": { "$ref": "#/$defs/sha256" },
        "zoom_percent": { "const": 100 }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "subject", "thumbprint"],
      "properties": {
        "kind": { "const": "authenticode" },
        "status": {
          "enum": ["Valid", "NotSigned", "HashMismatch", "NotTrusted", "UnknownError", "NotSupported", "Incompatible"]
        },
        "subject": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\r\\n]+$" }
          ]
        },
        "thumbprint": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/thumbprint" }
          ]
        }
      }
    },
    "runtimeReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "report_sha256",
        "permissions",
        "desktop_unlocked",
        "observation_succeeded",
        "integrity"
      ],
      "properties": {
        "source": { "const": "computer-use doctor --json" },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "permissions": { "enum": ["granted", "required", "unknown"] },
        "desktop_unlocked": { "const": true },
        "observation_succeeded": { "const": true },
        "integrity": { "const": "not_reported_by_runtime" }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "iterations_expected",
        "iterations_passed",
        "action_protocol_variants",
        "successful_actions_per_iteration",
        "stale_snapshot_rejections",
        "new_snapshot_assertions",
        "plugin_seam_failures",
        "fixture_oracle"
      ],
      "properties": {
        "passed": { "const": true },
        "iterations_expected": { "type": "integer", "minimum": 1 },
        "iterations_passed": { "type": "integer", "minimum": 1 },
        "action_protocol_variants": { "const": 9 },
        "successful_actions_per_iteration": { "const": 11 },
        "stale_snapshot_rejections": { "type": "integer", "minimum": 1 },
        "new_snapshot_assertions": { "type": "integer", "minimum": 1 },
        "plugin_seam_failures": { "const": 0 },
        "fixture_oracle": { "const": "loopback-http-state" }
      }
    },
    "limitations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_privilege_mismatch", "uac_secure_desktop"],
      "properties": {
        "target_privilege_mismatch": { "const": "not_detected" },
        "uac_secure_desktop": { "const": "unsupported" }
      }
    }
  }
}
