{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-computer-use.invalid/schemas/macos-development-acceptance-v1.json",
  "title": "Redacted macOS Development Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "status",
    "metadata",
    "scenarios",
    "timings",
    "cleanup_passed",
    "timestamp"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "computer-use-macos-development-acceptance" },
    "status": { "enum": ["passed", "degraded"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_version",
        "protocol_version",
        "engine_version",
        "macos_version",
        "architecture"
      ],
      "properties": {
        "product_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "protocol_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "engine_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "macos_version": {
          "type": "string",
          "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$",
          "maxLength": 32
        },
        "architecture": { "enum": ["arm64", "x86_64"] }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "two_tool_inventory",
        "desktop_png",
        "fresh_snapshot",
        "stale_snapshot_rejected",
        "exact_window_discovered",
        "window_png_and_element",
        "background_element_effect",
        "window_coordinate_effect",
        "old_refs_rejected_after_reconnect"
      ],
      "properties": {
        "two_tool_inventory": { "const": true },
        "desktop_png": { "const": true },
        "fresh_snapshot": { "const": true },
        "stale_snapshot_rejected": { "const": true },
        "exact_window_discovered": { "const": true },
        "window_png_and_element": { "const": true },
        "background_element_effect": { "const": true },
        "window_coordinate_effect": { "const": true },
        "old_refs_rejected_after_reconnect": { "const": true }
      }
    },
    "timings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "mcp_start" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "target_ms": { "const": 2000 },
            "hard_limit_ms": { "const": 10000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "desktop_observe" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 3000 },
            "target_ms": { "const": 1000 },
            "hard_limit_ms": { "const": 3000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "window_discover" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 3000 },
            "target_ms": { "const": 1000 },
            "hard_limit_ms": { "const": 3000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "window_observe" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 3000 },
            "target_ms": { "const": 1000 },
            "hard_limit_ms": { "const": 3000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "coordinate_action" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 3000 },
            "target_ms": { "const": 1000 },
            "hard_limit_ms": { "const": 3000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "element_action" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 8000 },
            "target_ms": { "const": 3000 },
            "hard_limit_ms": { "const": 8000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
          "properties": {
            "name": { "const": "mcp_reconnect" },
            "duration_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
            "target_ms": { "const": 2000 },
            "hard_limit_ms": { "const": 10000 },
            "status": { "enum": ["target_met", "degraded"] }
          }
        }
      ],
      "items": false
    },
    "cleanup_passed": { "const": true },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$",
      "maxLength": 40
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["status", "timings"],
      "properties": {
        "status": { "const": "passed" },
        "timings": {
          "type": "array",
          "prefixItems": [
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
            { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } }
          ],
          "items": false
        }
      }
    },
    {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "degraded" } }
    }
  ]
}
