{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-computer-use.invalid/schemas/macos-development-acceptance-v4.json",
  "title": "Redacted macOS Development Acceptance Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "status", "metadata", "scenarios", "timings", "performance", "adaptive_correctness", "real_app_smoke", "cleanup_passed", "timestamp"],
  "properties": {
    "schema_version": { "const": 4 },
    "evidence_type": { "const": "computer-use-macos-development-acceptance" },
    "status": { "enum": ["passed", "degraded", "failed"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "protocol_version", "engine_version", "macos_version", "architecture"],
      "properties": {
        "product_version": { "const": "0.2.7" },
        "protocol_version": { "const": "1.2.0" },
        "engine_version": { "const": "0.22.2" },
        "macos_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$", "maxLength": 32 },
        "architecture": { "enum": ["arm64", "x86_64"] }
      }
    },
    "scenarios": { "$ref": "#/$defs/scenarios" },
    "timings": { "$ref": "#/$defs/timings" },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_visual_observe", "window_semantic_observe", "semantic_action_next_state", "pixel_action_next_state"],
      "properties": {
        "window_visual_observe": {
          "allOf": [
            { "$ref": "#/$defs/performanceProfile" },
            { "$ref": "#/$defs/visualStatus" },
            { "$ref": "#/$defs/passedObserveOrFailed" }
          ]
        },
        "window_semantic_observe": {
          "allOf": [
            { "$ref": "#/$defs/performanceProfile" },
            { "$ref": "#/$defs/semanticStatus" },
            { "$ref": "#/$defs/passedObserveOrFailed" }
          ]
        },
        "semantic_action_next_state": {
          "allOf": [
            { "$ref": "#/$defs/performanceProfile" },
            { "$ref": "#/$defs/semanticActionStatus" },
            { "$ref": "#/$defs/passedActionOrFailed" }
          ]
        },
        "pixel_action_next_state": {
          "allOf": [
            { "$ref": "#/$defs/performanceProfile" },
            { "$ref": "#/$defs/pixelActionStatus" },
            { "$ref": "#/$defs/passedActionOrFailed" }
          ]
        }
      }
    },
    "adaptive_correctness": { "$ref": "#/$defs/adaptiveCorrectness" },
    "real_app_smoke": { "$ref": "#/$defs/realAppSmoke" },
    "cleanup_passed": { "const": true },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$", "maxLength": 40 }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["status", "scenarios", "timings", "performance", "adaptive_correctness", "real_app_smoke"],
      "properties": {
        "status": { "const": "passed" },
        "scenarios": { "$ref": "#/$defs/allScenariosTrue" },
        "timings": { "$ref": "#/$defs/allTimingsTargetMet" },
        "performance": { "$ref": "#/$defs/allPerformancePassed" },
        "adaptive_correctness": { "$ref": "#/$defs/allAdaptiveTrue" },
        "real_app_smoke": { "$ref": "#/$defs/passingSmoke" }
      }
    },
    {
      "type": "object",
      "required": ["status", "scenarios", "timings", "performance", "adaptive_correctness", "real_app_smoke"],
      "properties": {
        "status": { "const": "degraded" },
        "scenarios": { "$ref": "#/$defs/allScenariosTrue" },
        "timings": { "$ref": "#/$defs/degradedTimings" },
        "performance": { "$ref": "#/$defs/allPerformancePassed" },
        "adaptive_correctness": { "$ref": "#/$defs/allAdaptiveTrue" },
        "real_app_smoke": { "$ref": "#/$defs/passingSmoke" }
      }
    },
    {
      "type": "object",
      "required": ["status"],
      "properties": { "status": { "const": "failed" } },
      "anyOf": [
        { "properties": { "scenarios": { "properties": { "two_tool_inventory": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "desktop_png": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "fresh_snapshot": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "stale_snapshot_rejected": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "exact_window_discovered": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "window_png_and_element": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "background_element_effect": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "window_coordinate_effect": { "const": false } } } } },
        { "properties": { "scenarios": { "properties": { "old_refs_rejected_after_reconnect": { "const": false } } } } },
        { "properties": { "timings": { "contains": { "properties": { "status": { "const": "failed" } } }, "minContains": 1 } } },
        { "properties": { "performance": { "properties": { "window_visual_observe": { "properties": { "status": { "const": "failed" } } } } } } },
        { "properties": { "performance": { "properties": { "window_semantic_observe": { "properties": { "status": { "const": "failed" } } } } } } },
        { "properties": { "performance": { "properties": { "semantic_action_next_state": { "properties": { "status": { "const": "failed" } } } } } } },
        { "properties": { "performance": { "properties": { "pixel_action_next_state": { "properties": { "status": { "const": "failed" } } } } } } },
        { "properties": { "adaptive_correctness": { "properties": { "no_fixed_action_delay": { "const": false } } } } },
        { "properties": { "adaptive_correctness": { "properties": { "semantic_sequence": { "const": false } } } } },
        { "properties": { "adaptive_correctness": { "properties": { "pixel_once": { "const": false } } } } },
        { "properties": { "adaptive_correctness": { "properties": { "unique_input_once": { "const": false } } } } },
        { "properties": { "adaptive_correctness": { "properties": { "visual_recovery_once": { "const": false } } } } },
        { "properties": { "adaptive_correctness": { "properties": { "focus_preserved": { "const": false } } } } },
        { "properties": { "real_app_smoke": { "properties": { "calculator_703": { "const": false } } } } },
        { "properties": { "real_app_smoke": { "properties": { "textedit_unique_value": { "const": false } } } } },
        { "properties": { "real_app_smoke": { "properties": { "textedit_single_write": { "const": false } } } } },
        { "properties": { "real_app_smoke": { "required": ["error_code"] } } },
        { "properties": { "real_app_smoke": { "required": ["cleanup_failed"] } } }
      ]
    }
  ],
  "$defs": {
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["two_tool_inventory", "desktop_png", "fresh_snapshot", "stale_snapshot_rejected", "exact_window_discovered", "window_png_and_element", "background_element_effect", "window_coordinate_effect", "old_refs_rejected_after_reconnect"],
      "properties": {
        "two_tool_inventory": { "type": "boolean" },
        "desktop_png": { "type": "boolean" },
        "fresh_snapshot": { "type": "boolean" },
        "stale_snapshot_rejected": { "type": "boolean" },
        "exact_window_discovered": { "type": "boolean" },
        "window_png_and_element": { "type": "boolean" },
        "background_element_effect": { "type": "boolean" },
        "window_coordinate_effect": { "type": "boolean" },
        "old_refs_rejected_after_reconnect": { "type": "boolean" }
      }
    },
    "allScenariosTrue": {
      "type": "object",
      "required": ["two_tool_inventory", "desktop_png", "fresh_snapshot", "stale_snapshot_rejected", "exact_window_discovered", "window_png_and_element", "background_element_effect", "window_coordinate_effect", "old_refs_rejected_after_reconnect"],
      "properties": {
        "two_tool_inventory": { "const": true },
        "desktop_png": { "const": true },
        "fresh_snapshot": { "const": true },
        "stale_snapshot_rejected": { "const": true },
        "exact_window_discovered": { "const": true },
        "window_png_and_element": { "const": true },
        "background_element_effect": { "const": true },
        "window_coordinate_effect": { "const": true },
        "old_refs_rejected_after_reconnect": { "const": true }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "duration_ms", "target_ms", "hard_limit_ms", "status"],
      "properties": {
        "name": { "type": "string" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "target_ms": { "type": "integer" },
        "hard_limit_ms": { "type": "integer" },
        "status": { "enum": ["target_met", "degraded", "failed"] }
      }
    },
    "timings": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "mcp_start" }, "target_ms": { "const": 2000 }, "hard_limit_ms": { "const": 10000 } } }] },
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "desktop_observe" }, "target_ms": { "const": 1000 }, "hard_limit_ms": { "const": 3000 } } }] },
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "window_discover" }, "target_ms": { "const": 1000 }, "hard_limit_ms": { "const": 3000 } } }] },
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "window_observe" }, "target_ms": { "const": 1000 }, "hard_limit_ms": { "const": 3000 } } }] },
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "coordinate_action" }, "target_ms": { "const": 1000 }, "hard_limit_ms": { "const": 3000 } } }] },
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "element_action" }, "target_ms": { "const": 3000 }, "hard_limit_ms": { "const": 8000 } } }] },
        { "allOf": [{ "$ref": "#/$defs/timing" }, { "type": "object", "required": ["name", "target_ms", "hard_limit_ms"], "properties": { "name": { "const": "mcp_reconnect" }, "target_ms": { "const": 2000 }, "hard_limit_ms": { "const": 10000 } } }] }
      ],
      "items": false
    },
    "allTimingsTargetMet": {
      "type": "array",
      "prefixItems": [
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } }, { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } }, { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } }, { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "target_met" } } }
      ]
    },
    "degradedTimings": {
      "type": "array",
      "contains": { "type": "object", "required": ["status"], "properties": { "status": { "const": "degraded" } } },
      "minContains": 1,
      "prefixItems": [
        { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } }, { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } }, { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } }, { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["target_met", "degraded"] } } }
      ]
    },
    "stageAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "p50_ms", "p95_ms", "max_ms"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1, "maximum": 30 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "max_ms": { "type": "number", "minimum": 0 }
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queue_wait": { "$ref": "#/$defs/stageAggregate" },
        "engine_execute": { "$ref": "#/$defs/stageAggregate" },
        "post_action_observe": { "$ref": "#/$defs/stageAggregate" },
        "projection": { "$ref": "#/$defs/stageAggregate" },
        "tool_total": { "$ref": "#/$defs/stageAggregate" },
        "transport_overhead": { "$ref": "#/$defs/stageAggregate" }
      }
    },
    "failureCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_error": { "type": "integer", "minimum": 1, "maximum": 30 },
        "contract_mismatch": { "type": "integer", "minimum": 1, "maximum": 30 },
        "oracle_mismatch": { "type": "integer", "minimum": 1, "maximum": 30 },
        "target_lost": { "type": "integer", "minimum": 1, "maximum": 30 },
        "fixture_unavailable": { "type": "integer", "minimum": 1, "maximum": 30 },
        "telemetry_missing": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "routeCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessibility": { "type": "integer", "minimum": 1, "maximum": 30 },
        "synthetic_events": { "type": "integer", "minimum": 1, "maximum": 30 },
        "global_input": { "type": "integer", "minimum": 1, "maximum": 30 },
        "system_api": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dom": { "type": "integer", "minimum": 1, "maximum": 30 },
        "trusted_input": { "type": "integer", "minimum": 1, "maximum": 30 },
        "unknown": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "performanceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "correct_count", "failed_count", "success_rate", "p50_ms", "p95_ms", "max_ms", "slo", "latency_status", "correctness_status", "failure_counts", "route_counts", "stages", "status"],
      "properties": {
        "sample_count": { "const": 30 },
        "correct_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "failed_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "max_ms": { "type": "number", "minimum": 0 },
        "slo": { "type": "object" },
        "latency_status": { "enum": ["passed", "failed"] },
        "correctness_status": { "enum": ["passed", "failed"] },
        "failure_counts": { "$ref": "#/$defs/failureCounts" },
        "route_counts": { "$ref": "#/$defs/routeCounts" },
        "stages": { "$ref": "#/$defs/stages" },
        "status": { "enum": ["passed", "failed"] }
      }
    },
    "visualSlo": { "type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms"], "properties": { "p50_ms": { "const": 700 }, "p95_ms": { "const": 1500 } } },
    "semanticSlo": { "type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms"], "properties": { "p50_ms": { "const": 400 }, "p95_ms": { "const": 1000 } } },
    "semanticActionSlo": { "type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms"], "properties": { "p50_ms": { "const": 1500 }, "p95_ms": { "const": 2000 } } },
    "pixelActionSlo": { "type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms"], "properties": { "p50_ms": { "const": 1500 }, "p95_ms": { "const": 3000 } } },
    "visualStatus": {
      "type": "object", "required": ["status", "slo"], "properties": { "slo": { "$ref": "#/$defs/visualSlo" } },
      "oneOf": [
        { "type": "object", "required": ["status", "p50_ms", "p95_ms"], "properties": { "status": { "const": "passed" }, "p50_ms": { "maximum": 700 }, "p95_ms": { "maximum": 1500 } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "failed" } } }
      ]
    },
    "semanticStatus": {
      "type": "object", "required": ["status", "slo"], "properties": { "slo": { "$ref": "#/$defs/semanticSlo" } },
      "oneOf": [
        { "type": "object", "required": ["status", "p50_ms", "p95_ms"], "properties": { "status": { "const": "passed" }, "p50_ms": { "maximum": 400 }, "p95_ms": { "maximum": 1000 } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "failed" } } }
      ]
    },
    "semanticActionStatus": {
      "type": "object", "required": ["status", "slo"], "properties": { "slo": { "$ref": "#/$defs/semanticActionSlo" } },
      "oneOf": [
        { "type": "object", "required": ["status", "p50_ms", "p95_ms"], "properties": { "status": { "const": "passed" }, "p50_ms": { "maximum": 1500 }, "p95_ms": { "maximum": 2000 } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "failed" } } }
      ]
    },
    "pixelActionStatus": {
      "type": "object", "required": ["status", "slo"], "properties": { "slo": { "$ref": "#/$defs/pixelActionSlo" } },
      "oneOf": [
        { "type": "object", "required": ["status", "p50_ms", "p95_ms"], "properties": { "status": { "const": "passed" }, "p50_ms": { "maximum": 1500 }, "p95_ms": { "maximum": 3000 } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "failed" } } }
      ]
    },
    "completeObserveStages": {
      "type": "object",
      "required": ["queue_wait", "post_action_observe", "projection", "tool_total", "transport_overhead"],
      "properties": {
        "queue_wait": { "properties": { "sample_count": { "const": 30 } } },
        "post_action_observe": { "properties": { "sample_count": { "const": 30 } } },
        "projection": { "properties": { "sample_count": { "const": 30 } } },
        "tool_total": { "properties": { "sample_count": { "const": 30 } } },
        "transport_overhead": { "properties": { "sample_count": { "const": 30 } } }
      }
    },
    "completeActionStages": {
      "type": "object",
      "required": ["queue_wait", "engine_execute", "post_action_observe", "projection", "tool_total", "transport_overhead"],
      "properties": {
        "queue_wait": { "properties": { "sample_count": { "const": 30 } } },
        "engine_execute": { "properties": { "sample_count": { "const": 30 } } },
        "post_action_observe": { "properties": { "sample_count": { "const": 30 } } },
        "projection": { "properties": { "sample_count": { "const": 30 } } },
        "tool_total": { "properties": { "sample_count": { "const": 30 } } },
        "transport_overhead": { "properties": { "sample_count": { "const": 30 } } }
      }
    },
    "passedObserveOrFailed": {
      "oneOf": [
        { "type": "object", "required": ["status", "correct_count", "failed_count", "success_rate", "latency_status", "correctness_status", "failure_counts", "route_counts", "stages"], "properties": { "status": { "const": "passed" }, "correct_count": { "const": 30 }, "failed_count": { "const": 0 }, "success_rate": { "const": 1 }, "latency_status": { "const": "passed" }, "correctness_status": { "const": "passed" }, "failure_counts": { "type": "object", "additionalProperties": false, "properties": {} }, "route_counts": { "type": "object", "additionalProperties": false, "properties": {} }, "stages": { "$ref": "#/$defs/completeObserveStages" } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "failed" } } }
      ]
    },
    "passedActionOrFailed": {
      "oneOf": [
        { "type": "object", "required": ["status", "correct_count", "failed_count", "success_rate", "latency_status", "correctness_status", "failure_counts", "route_counts", "stages"], "properties": { "status": { "const": "passed" }, "correct_count": { "const": 30 }, "failed_count": { "const": 0 }, "success_rate": { "const": 1 }, "latency_status": { "const": "passed" }, "correctness_status": { "const": "passed" }, "failure_counts": { "type": "object", "additionalProperties": false, "properties": {} }, "route_counts": { "allOf": [{ "$ref": "#/$defs/routeCounts" }, { "minProperties": 1 }] }, "stages": { "$ref": "#/$defs/completeActionStages" } } },
        { "type": "object", "required": ["status"], "properties": { "status": { "const": "failed" } } }
      ]
    },
    "allPerformancePassed": {
      "type": "object",
      "required": ["window_visual_observe", "window_semantic_observe", "semantic_action_next_state", "pixel_action_next_state"],
      "properties": {
        "window_visual_observe": { "type": "object", "required": ["status"], "properties": { "status": { "const": "passed" } } },
        "window_semantic_observe": { "type": "object", "required": ["status"], "properties": { "status": { "const": "passed" } } },
        "semantic_action_next_state": { "type": "object", "required": ["status"], "properties": { "status": { "const": "passed" } } },
        "pixel_action_next_state": { "type": "object", "required": ["status"], "properties": { "status": { "const": "passed" } } }
      }
    },
    "adaptiveCorrectness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_fixed_action_delay", "semantic_sequence", "pixel_once", "unique_input_once", "visual_recovery_once", "focus_preserved"],
      "properties": {
        "no_fixed_action_delay": { "type": "boolean" }, "semantic_sequence": { "type": "boolean" },
        "pixel_once": { "type": "boolean" }, "unique_input_once": { "type": "boolean" },
        "visual_recovery_once": { "type": "boolean" }, "focus_preserved": { "type": "boolean" }
      }
    },
    "allAdaptiveTrue": {
      "type": "object",
      "required": ["no_fixed_action_delay", "semantic_sequence", "pixel_once", "unique_input_once", "visual_recovery_once", "focus_preserved"],
      "properties": {
        "no_fixed_action_delay": { "const": true }, "semantic_sequence": { "const": true },
        "pixel_once": { "const": true }, "unique_input_once": { "const": true },
        "visual_recovery_once": { "const": true }, "focus_preserved": { "const": true }
      }
    },
    "realAppSmoke": {
