{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://universal-computer-use.invalid/schemas/macos-development-profile-v1.json",
  "title": "Redacted macOS Development Performance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "status", "metadata", "profile_name", "performance", "cleanup_passed", "timestamp"],
  "properties": {
    "schema_version": { "const": 1 },
    "evidence_type": { "const": "computer-use-macos-development-profile" },
    "status": { "enum": ["passed", "failed"] },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "protocol_version", "engine_version", "macos_version", "architecture"],
      "properties": {
        "product_version": { "const": "0.2.8" },
        "protocol_version": { "const": "1.2.0" },
        "engine_version": { "const": "0.22.2" },
        "macos_version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$", "maxLength": 32 },
        "architecture": { "enum": ["arm64", "x86_64"] }
      }
    },
    "profile_name": { "enum": ["window_visual_observe", "window_semantic_observe", "semantic_action_next_state", "pixel_action_next_state"] },
    "performance": { "$ref": "#/$defs/performanceProfile" },
    "cleanup_passed": { "const": true },
    "timestamp": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$", "maxLength": 40 }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "passed" } } },
      "then": { "properties": { "performance": { "properties": { "status": { "const": "passed" }, "correct_count": { "const": 30 }, "failed_count": { "const": 0 }, "success_rate": { "const": 1 } } } } },
      "else": { "properties": { "performance": { "properties": { "status": { "const": "failed" } } } } }
    },
    {
      "if": { "properties": { "profile_name": { "enum": ["window_visual_observe", "window_semantic_observe"] } } },
      "then": { "properties": { "performance": { "properties": { "route_counts": { "type": "object", "additionalProperties": false, "maxProperties": 0 } } } } }
    },
    {
      "if": {
        "required": ["profile_name", "status"],
        "properties": {
          "profile_name": { "enum": ["semantic_action_next_state", "pixel_action_next_state"] },
          "status": { "const": "passed" }
        }
      },
      "then": { "properties": { "performance": { "properties": { "route_counts": { "minProperties": 1 } } } } }
    }
  ],
  "$defs": {
    "countMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool_error": { "type": "integer", "minimum": 1, "maximum": 30 },
        "contract_mismatch": { "type": "integer", "minimum": 1, "maximum": 30 },
        "oracle_mismatch": { "type": "integer", "minimum": 1, "maximum": 30 },
        "target_lost": { "type": "integer", "minimum": 1, "maximum": 30 },
        "fixture_unavailable": { "type": "integer", "minimum": 1, "maximum": 30 },
        "telemetry_missing": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "routeCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accessibility": { "type": "integer", "minimum": 1, "maximum": 30 },
        "synthetic_events": { "type": "integer", "minimum": 1, "maximum": 30 },
        "global_input": { "type": "integer", "minimum": 1, "maximum": 30 },
        "system_api": { "type": "integer", "minimum": 1, "maximum": 30 },
        "dom": { "type": "integer", "minimum": 1, "maximum": 30 },
        "trusted_input": { "type": "integer", "minimum": 1, "maximum": 30 },
        "unknown": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "p50_ms", "p95_ms", "max_ms"],
      "properties": {
        "sample_count": { "type": "integer", "minimum": 1, "maximum": 30 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "max_ms": { "type": "number", "minimum": 0 }
      }
    },
    "performanceProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "correct_count", "failed_count", "success_rate", "p50_ms", "p95_ms", "max_ms", "slo", "latency_status", "correctness_status", "failure_counts", "route_counts", "stages", "status"],
      "properties": {
        "sample_count": { "const": 30 },
        "correct_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "failed_count": { "type": "integer", "minimum": 0, "maximum": 30 },
        "success_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "max_ms": { "type": "number", "minimum": 0 },
        "slo": { "type": "object", "additionalProperties": false, "required": ["p50_ms", "p95_ms"], "properties": { "p50_ms": { "type": "number", "minimum": 0 }, "p95_ms": { "type": "number", "minimum": 0 } } },
        "latency_status": { "enum": ["passed", "failed"] },
        "correctness_status": { "enum": ["passed", "failed"] },
        "failure_counts": { "$ref": "#/$defs/countMap" },
        "route_counts": { "$ref": "#/$defs/routeCounts" },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "queue_wait": { "$ref": "#/$defs/stage" },
            "engine_execute": { "$ref": "#/$defs/stage" },
            "post_action_observe": { "$ref": "#/$defs/stage" },
            "projection": { "$ref": "#/$defs/stage" },
            "tool_total": { "$ref": "#/$defs/stage" },
            "transport_overhead": { "$ref": "#/$defs/stage" }
          }
        },
        "status": { "enum": ["passed", "failed"] }
      }
    }
  }
}
